# Variables lues par `docker compose` : copier en .env et remplir.
# Générer un secret : openssl rand -hex 32
#
# Les secrets n'ont volontairement aucune valeur par défaut : compose refuse de
# démarrer tant qu'ils ne sont pas définis.

# Signature des tokens JWT (32 caractères minimum en production)
KPAY_COMPOSE_JWT_SECRET=
# Mot de passe PostgreSQL
KPAY_COMPOSE_DB_PASSWORD=
# Identifiants MinIO (utilisateur root, aussi utilisé pour stocker les bulletins)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# Clé API (header X-Api-Key) : droits admin sur l'organisation plateforme (org 1).
# Laisser vide pour désactiver ce mode d'authentification (recommandé).
KPAY_COMPOSE_API_KEY=

# Optionnel
# KPAY_COMPOSE_DB_USER=kpay_user
# KPAY_COMPOSE_DB_NAME=kpay_db
